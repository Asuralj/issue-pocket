<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CanvasBrush}">
    <Grid Margin="19,16,19,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="设置" FontWeight="Bold" FontSize="23" Margin="1,0,0,14" />
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,11">
                <StackPanel>
                    <TextBlock Text="快速记录快捷键" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ActiveShortcut" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,9" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="ApplyShortcut" Content="应用" MinWidth="65" Margin="8,0,0,0" />
                        <Button x:Name="ShortcutCapture" Height="36" HorizontalContentAlignment="Left" ToolTip="点击后按键录入"
                                AutomationProperties.Name="按键录入快速记录快捷键" />
                    </DockPanel>
                    <TextBlock x:Name="ShortcutFeedback" Text="点击键位按钮后直接按键，支持单键和组合键。" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Padding="14">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" x:Name="StartupToggle" Width="43" Height="24" Cursor="Hand" Margin="10,0,0,0"
                                  VerticalAlignment="Center" AutomationProperties.Name="开机自启">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Track" Background="{DynamicResource BorderBrush}" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}" Padding="3">
                                    <Border x:Name="Thumb" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Width="16" Height="16"
                                            HorizontalAlignment="Left" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Thumb" Property="Background" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel>
                        <TextBlock Text="开机自启" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="StartupFeedback" Text="登录 Windows 后自动驻留系统托盘" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" HorizontalAlignment="Right" MinWidth="73" Margin="0,9,0,0" />
    </Grid>
</Grid>
