<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CanvasBrush}">
    <Grid.Resources>
        <Style x:Key="NavRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="39" />
        </Style>
        <DataTemplate x:Key="NavTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentText}"
                      VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <Style x:Key="IssueRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="88" />
        </Style>
        <Style x:Key="StatePill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OpenFill}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Resolved}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DoneFill}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource OpenInk}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Resolved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DoneInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="218" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,19,16,14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,21">
                <Border Width="39" Height="39" CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                    <Path Width="18" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          Data="M3,1 H14 Q16,1 16,3 V19 H3 Q1,19 1,17 V3 Q1,1 3,1 Z M5,6 H12 M5,10 H12 M5,14 H10"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="问题随手记" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="19" FontWeight="Bold" />
            </StackPanel>
            <Button Grid.Row="1" x:Name="NewButton" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Path Width="13" Height="13" Margin="0,0,7,0" Data="M0,6.5 H13 M6.5,0 V13" Stroke="White" StrokeThickness="1.7" VerticalAlignment="Center" />
                    <TextBlock Text="新建问题" Foreground="White" />
                </StackPanel>
            </Button>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ListBox x:Name="Views" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource NavRow}" ItemTemplate="{StaticResource NavTemplate}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="问题状态" />
                <DockPanel Grid.Row="1" Margin="0,11,0,4">
                    <Button DockPanel.Dock="Right" x:Name="NewCategory" Content="＋ 新建分类" Style="{StaticResource TextAction}" />
                    <TextBlock Text="分类" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="2" x:Name="Categories" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource NavRow}" ItemTemplate="{StaticResource NavTemplate}"
                         AutomationProperties.Name="问题分类" />
            </Grid>
            <StackPanel Grid.Row="3">
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,9,0,7" />
                <Button x:Name="ThemeButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0,0,0,1" />
                <Button x:Name="DataButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Content="数据与备份  ▾" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="设置"
                            AutomationProperties.Name="设置" Width="34" Height="34" MinHeight="34" Padding="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
                    </Button>
                    <TextBlock x:Name="ShortcutHint" Margin="3,0,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20,20,20,9">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="27" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34*" MinWidth="244" /><ColumnDefinition Width="14" /><ColumnDefinition Width="66*" MinWidth="380" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Surface}" Padding="15,17,15,11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ViewTitle" Text="全部问题" FontWeight="Bold" FontSize="24" TextTrimming="CharacterEllipsis" Margin="1,0,0,13" />
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="Search" Height="40" Padding="31,8,27,8" AutomationProperties.Name="搜索问题、处理结果、跟进和附件" />
                        <Path Width="13" Height="13" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Data="M5,1 A4,4 0 1 1 4.99,1 M8,8 L12,12" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索问题、结果、跟进和附件" Margin="31,0,22,0" VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                        <Button x:Name="ClearSearch" Style="{StaticResource QuietButton}" Content="×" AutomationProperties.Name="清空搜索"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,0" MinHeight="25" Margin="0,0,4,0" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="ListCount" Grid.Row="2" Style="{StaticResource MutedText}" Margin="2,1,0,9" />
                    <ListBox x:Name="Records" Grid.Row="3" Style="{StaticResource FlatList}" ItemContainerStyle="{StaticResource IssueRow}"
                             AutomationProperties.Name="问题列表" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Grid.Row="1" Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" Margin="0,4,0,7" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource StatePill}"><TextBlock Text="{Binding State}" Style="{StaticResource StateText}" /></Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource MutedText}" FontSize="11"
                                                   Margin="8,0,7,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <Grid x:Name="EmptyState" MaxWidth="400" Margin="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="17" Background="{DynamicResource SelectedBrush}" Margin="0,0,0,16">
                                <Path Width="26" Height="27" Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.65" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      Data="M3,1 H19 Q21,1 21,3 V24 H3 Q1,24 1,22 V3 Q1,1 3,1 Z M6,7 H16 M6,12 H16 M6,17 H12"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="还没有问题" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                            <Button x:Name="ResetFilters" Content="清除筛选" Style="{StaticResource TextAction}" HorizontalAlignment="Center" Margin="0,9,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="Detail" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="22,16,21,0" LastChildFill="True">
                            <Button x:Name="ToggleStatus" DockPanel.Dock="Right" Content="标为已解决" Margin="8,0,0,0" />
                            <Button x:Name="Edit" DockPanel.Dock="Right" Content="编辑" />
                            <Button x:Name="AddFollowUp" DockPanel.Dock="Right" Content="＋ 追加跟进" Style="{StaticResource TextAction}" Margin="0,0,7,0" />
                            <TextBlock Text="问题详情" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="22,14,21,22">
                                <TextBlock x:Name="IssueTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <WrapPanel Margin="0,0,0,18" VerticalAlignment="Center">
                                    <Border x:Name="DetailPill" Style="{StaticResource StatePill}" Padding="8,3">
                                        <TextBlock x:Name="DetailState" Style="{StaticResource StateText}" />
                                    </Border>
                                    <TextBlock x:Name="IssueCategory" Style="{StaticResource MutedText}" Margin="10,2,10,0" TextWrapping="Wrap" MaxWidth="225" />
                                    <TextBlock x:Name="IssueDate" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </WrapPanel>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,18" />
                                <TextBlock Text="问题描述" Style="{StaticResource FieldLabel}" />
                                <ContentControl x:Name="IssueBody" />
                                <Border Style="{StaticResource Surface}" Background="{DynamicResource PanelBrush}" Padding="13,8,13,13" Margin="0,19,0,0" CornerRadius="9">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Button x:Name="EditResult" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="填写结果" />
                                            <TextBlock Text="处理结果" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="EmptyResult" Style="{StaticResource MutedText}" Text="还没有填写处理结果" Margin="0,1,0,0" />
                                        <ContentControl x:Name="IssueResult" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="AttachmentArea" Margin="0,20,0,0">
                                    <TextBlock x:Name="AttachmentsHeading" Text="附件" Style="{StaticResource FieldLabel}" />
                                    <WrapPanel x:Name="Attachments" />
                                </StackPanel>
                                <StackPanel x:Name="FollowUpArea" Margin="0,20,0,0">
                                    <TextBlock x:Name="FollowUpHeading" Text="跟进记录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="EmptyFollowUps" Text="还没有跟进记录" Style="{StaticResource MutedText}" />
                                    <ItemsControl x:Name="FollowUps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Surface}" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                                        Padding="12,9" Margin="0,0,0,7">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,3">
                                                            <Button DockPanel.Dock="Right" Content="编辑" AutomationProperties.Name="编辑这条跟进"
                                                                    Style="{StaticResource TextAction}" MinHeight="26" Padding="8,2"
                                                                    Command="{Binding EditCommand}" CommandParameter="{Binding Entry}" />
                                                            <TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ContentPresenter Content="{Binding Preview}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="Feedback" Grid.Row="1" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
</Grid>
