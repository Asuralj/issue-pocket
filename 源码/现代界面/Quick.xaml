<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CanvasBrush}">
<Grid Margin="23,17,23,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="记录问题" FontSize="24" FontWeight="Bold" Margin="1,0,0,14" />
    <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="17">
      <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="标题" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <TextBox x:Name="TitleInput" Height="36" MaxLength="160" AutomationProperties.Name="标题" />
                    <TextBlock x:Name="TitleHint" Text="选填，可用描述首行作标题" Style="{StaticResource MutedText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,8,0,4">
                <Button x:Name="PreviewBody" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="预览"
                        AutomationProperties.Name="预览问题描述" MinHeight="27" Padding="8,2" />
                <TextBlock Text="问题描述" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <Grid Grid.Row="2">
                <TextBox x:Name="BodyInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" MaxLength="120000" AutomationProperties.Name="问题描述" MinHeight="86" />
                <TextBlock x:Name="BodyHint" Text="记录遇到的问题，或直接粘贴文字、截图" Style="{StaticResource MutedText}"
                           Margin="12,10,0,0" VerticalAlignment="Top" IsHitTestVisible="False" />
                <ScrollViewer x:Name="BodyPreview" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MinHeight="86" MaxHeight="240" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,13,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="19" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="分类" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox x:Name="CategoryInput" Height="35" MaxLength="40" Padding="11,7,39,7" AutomationProperties.Name="分类，可直接输入" />
                        <Button x:Name="CategoryMenu" Style="{StaticResource QuietButton}" Content="▾" MinHeight="28" Margin="0,0,3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="选择已有分类" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="状态" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="Pending" Style="{StaticResource SegmentButton}" Content="待处理" IsChecked="True" />
                            <ToggleButton x:Name="Resolved" Style="{StaticResource SegmentButton}" Content="已解决" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,8,0,2">
                <Button x:Name="ShowResult" Style="{StaticResource TextAction}" Content="＋ 填写处理结果" HorizontalAlignment="Left" Margin="-7,0,0,0" />
                <StackPanel x:Name="ResultFields" Visibility="Collapsed" Margin="0,4,0,7">
                    <DockPanel Margin="0,0,0,4">
                        <Button x:Name="PreviewResult" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="预览"
                                AutomationProperties.Name="预览处理结果" MinHeight="27" Padding="8,2" />
                        <TextBlock Text="处理结果" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="ResultInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="120000" Height="81"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="处理结果" />
                        <TextBlock x:Name="ResultHint" Text="写下解决办法、原因或处理结论" Style="{StaticResource MutedText}" Margin="12,10,0,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="ResultPreview" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" MaxHeight="185" MinHeight="81" />
                    </Grid>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,2,0,0">
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="AddFiles" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="添加文件…" />
                    <TextBlock Text="附件" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="DropArea" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="7" Height="96">
                    <Grid>
                        <TextBlock x:Name="DropHint" Text="拖入文件，或按 Ctrl+V 粘贴截图" Style="{StaticResource MutedText}"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Attachments" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,13,0,0" LastChildFill="True">
        <Button x:Name="Save" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="103" Height="38">
            <TextBlock Text="保存问题" Foreground="White" FontWeight="SemiBold" />
        </Button>
        <Button x:Name="Cancel" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="取消" Margin="0,0,8,0" />
        <TextBlock x:Name="Feedback" Text="Ctrl+Enter 保存" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="1,0,7,0" />
    </DockPanel>
</Grid>
</Grid>
